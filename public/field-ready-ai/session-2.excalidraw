    {
      "id": "6iv71Ft72IphcBvclDgJC",
      "type": "text",
      "x": 34.743040996365835,
      "y": 1602.4207240745118,
      "width": 1156.0391845703125,
      "height": 800,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
