      "text": "checkout_submit | avg | 1200ms | 1840ms | +53% | FAIL | CRITICAL",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "checkout_submit | avg | 1200ms | 1840ms | +53% | FAIL | CRITICAL",
      "autoResize": true,
