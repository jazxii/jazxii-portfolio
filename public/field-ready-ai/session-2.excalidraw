    },
    {
      "id": "FwsrNWmyFgug2Nl7iRqO-",
      "type": "text",
      "x": 1530.6033667949323,
      "y": 1568.2784937650313,
      "width": 1170.567138671875,
      "height": 245,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0N",
      "roundness": null,
      "seed": 57105272,
      "version": 714,
      "versionNonce": 1081539960,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784394876259,
      "link": null,
      "locked": false,
      "text": "| Part | What it does | Ask yourself |\n| Role | --> Activates the right slice of expertise | Who should be doing this task? |\n| Context | --> Facts it cannot guess | What would a new hire need to know first? |\n| Task | --> The verb, unambiguous | What exactly gets done — one clear action? |\n| Format | --> The shape of the output | What does the deliverable look like? |\n| Example | --> The single highest-leverage part | Can I show one row/paragraph of \"good\"? |\n",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "| Part | What it does | Ask yourself |\n| Role | --> Activates the right slice of expertise | Who should be doing this task? |\n| Context | --> Facts it cannot guess | What would a new hire need to know first? |\n| Task | --> The verb, unambiguous | What exactly gets done — one clear action? |\n| Format | --> The shape of the output | What does the deliverable look like? |\n| Example | --> The single highest-leverage part | Can I show one row/paragraph of \"good\"? |\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "6VEsXd6l3Da5lrfGbGtly",
      "type": "arrow",
      "x": 540.7014614840672,
      "y": 65.79843501674,
      "width": 0,
      "height": 0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
